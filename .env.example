# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OWNER_ADMIN_PASSCODE: Optional server-side passcode override for the Super Admin (patilakash74850@gmail.com).
# If left empty, the first-run Super Admin setup form lets the owner securely configure their password.
OWNER_ADMIN_PASSCODE=

# JWT_SECRET: Server-side secret used to sign session tokens (defaults to ephemeral random secret if unset).
JWT_SECRET=
